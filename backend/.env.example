# Copie este arquivo para ".env" e ajuste os valores antes de rodar o servidor.
#   Mac/Linux: cp .env.example .env
#   Windows:   copy .env.example .env

# Porta do servidor (site + API)
PORT=3333

# Segredo usado para assinar os tokens JWT.
# OBRIGATÓRIO trocar: gere um valor aleatório com
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Nunca commite o arquivo .env (só o .env.example) — ele está no .gitignore.
JWT_SECRET=troque-este-valor-por-uma-string-longa-e-aleatoria

# Tempo de expiração do token (formato da lib "jsonwebtoken": 15m, 8h, 7d...)
JWT_EXPIRES_IN=8h

# Origens extras permitidas via CORS (lista separada por vírgula).
# Só importa se você abrir o front em outra porta (ex.: extensão Live Server).
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# --- Google (opcionais: sem eles o site funciona normalmente) -------------------

# Login com Google. Client ID do tipo "Aplicativo da Web" (Google Cloud Console >
# APIs e serviços > Credenciais). Em "Origens JavaScript autorizadas" coloque
# http://localhost:3333 . Deixe vazio para esconder o botão "Entrar com Google".
GOOGLE_CLIENT_ID=

# Mapa da academia (Maps Embed API). Sem chave, o site usa o mapa simples do Google.
# Com chave, restrinja-a por "Referenciadores HTTP" (http://localhost:3333/*).
GOOGLE_MAPS_API_KEY=

# Pagamento de demonstração: true libera o botão que "simula" o aviso do banco
# (Pix/boleto). Em produção de verdade use false e confirme só por webhook do gateway.
PAGAMENTO_SIMULADO=true
